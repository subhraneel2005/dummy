    "test:approvals": "node --experimental-strip-types scripts/approval-smoke.mjs",
    "test:backends": "node --experimental-strip-types scripts/browser-backends-smoke.mjs",
    "test": "npm run test:providers && npm run test:approvals && npm run test:backends && npm run build && electron scripts/browser-smoke.mjs"
  },
