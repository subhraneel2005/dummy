    "electron": "^44.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.63",
    "@ai-sdk/google": "^4.0.80",
    "@ai-sdk/openai": "^4.0.75",
    "@ai-sdk/xai": "^5.0.8",
    "@browser_use/pi": "0.1.0",
    "@libsql/client": "^0.18.0",
